# ═══════════════════════════════════════════
# RideFlow AI — Environment Variables
# ═══════════════════════════════════════════

# ── Supabase ──────────────────────────────
# Create a project at https://supabase.com and copy these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Supabase PostgreSQL) ────────
# For local dev, use the Postgres from docker-compose.yml
DATABASE_URL=postgresql://rideflow:rideflow@localhost:5432/rideflow

# ── Auth ──────────────────────────────────
# Supabase Auth handles JWT. These are for custom session config.
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=3600

# ── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
PORT=4000

# ── Notifications (MVP: Email only) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=noreply@rideflow.ai

# ── OSRM (Route Optimization) ─────────────
OSRM_BASE_URL=http://localhost:5000

# ── Maps ──────────────────────────────────
# Using OpenStreetMap + Leaflet — no API key required.
# For tile layer customization (optional):
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
