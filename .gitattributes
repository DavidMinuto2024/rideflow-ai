# Auto-detect text files and enforce LF line endings
* text=auto eol=lf

# Source code — LF explicitly
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files — keep as-is
*.png binary
*.jpg binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
